--- !u!114 &1014839290
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1014839286}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 082adf5dc2f834c4eace1ed812a645df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AldricInteraction
  dialogueLines:
  - 'King Aldric: So you''re the mercenary. Good. I don''t have time to talk much. '
  - 'King Aldric: This was my brother''s castle. He ruled here, until the invasion
    came and took it from him.'
  - 'King Aldric: He didn''t survive. Neither did most of what this place used to
    be. '
  - 'King Aldric: The Great Relic was ours. Our family''s, passed down for generations.
    It held power enough to protect this entire castle. '
  - 'King Aldric: Whatever attacked this place broke it into pieces. They''re spread
    across the ruins now. Something''s taken each one. '
  - 'King Aldric: I don''t know what''s in there. Enemies, traps, things I can''t
    even name. No one who''s gone in has come back to tell me.'
  - 'King Aldric: Bring me every piece, and you''ll be paid more gold than you''ve
    ever seen. That''s the deal.'
  - 'King Aldric: The gate''s open. Whatever''s waiting past it is yours now.'
  dialogueText: {fileID: 243442996}
  dialoguePanel: {fileID: 162915901}
  playerMovement: {fileID: 1162953530}
  voiceSound: {fileID: 8300000, guid: 72ff3d3f817e0234aad625b011f28864, type: 3}
